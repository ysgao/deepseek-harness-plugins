{
  "name": "dsh-plugins-bundle-workspace-git",
  "description": "Installable dsh --profile patch layer that composes the workspace-git File manager plugins into a base/web-app profile",
  "version": "0.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-plugins-api-workspace-git-controller": "workspace:^",
    "dsh-plugins-api-workspace-file-controller": "workspace:^",
    "dsh-plugins-client-ui-file-editing": "workspace:^",
    "dsh-plugins-client-ui-workspace-files": "workspace:^",
    "dsh-plugins-client-ui-workspace-enhanced": "workspace:^",
    "dsh-plugins-client-ui-conversation-files": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
