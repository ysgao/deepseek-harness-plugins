{
  "name": "dsh-plugins-bundle-anthropic-subscription",
  "description": "Installable dsh --profile patch layer that mounts the generic ctx.authorization RPC controller, its Client Remote mount, and the Settings > Models sign-in panel into a web-app-derived profile",
  "version": "0.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-plugins-api-authorization-controller": "workspace:^",
    "dsh-plugins-client-remotes-anthropic-subscription": "workspace:^",
    "dsh-plugins-client-ui-settings-anthropic-subscription": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:^",
    "typescript": "^6.0.3"
  }
}
