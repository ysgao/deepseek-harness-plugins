{
  "name": "deepseek-harness-plugins-root",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/_vendor/deepseek-harness/vendor/*",
    "packages/_vendor/deepseek-harness/packages/*/*",
    "packages/_vendor/deepseek-harness/native/system",
    "packages/_vendor/deepseek-harness/native/system/packages/*",
    "packages/_vendor/deepseek-harness/apps/*",
    "packages/_vendor/deepseek-harness/benchmarks",
    "packages/_vendor/deepseek-harness/website",
    "packages/_vendor/deepseek-harness/python/sdk-runtime",
    "packages/workspace-git/*",
    "packages/anthropic-subscription/*",
    "packages/terminal/*"
  ],
  "scripts": {
    "build:vendor": "pnpm --dir packages/_vendor/deepseek-harness run build",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "build": "pnpm run build:lib:host && pnpm run build:lib:client",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "test": "vitest run",
    "check:parity": "node scripts/check-replacement-parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
